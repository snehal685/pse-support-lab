 func (c *Client) IsRegistered(ctx context.Context, participantID string) (bool, error) {
+	// A file repeats the same few buyers on every line; look each one up once.
+	c.mu.Lock()
+	if e, ok := c.cache[participantID]; ok && time.Now().Before(e.expires) {
+		c.mu.Unlock()
+		return e.registered, nil
+	}
+	c.mu.Unlock()
+	registered, err := c.lookup(ctx, participantID)
+	if err == nil {
+		c.mu.Lock()
+		c.cache[participantID] = cached{registered, time.Now().Add(cacheTTL)}
+		c.mu.Unlock()
+	}
+	return registered, err
+}
