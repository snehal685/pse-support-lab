+// sendWithBackoff honours the ASP fair-use limit: on HTTP 429 the document was not
+// received, so wait for Retry-After and send it again.
+func (s *Submitter) sendWithBackoff(ctx context.Context, id, number, sender string, payload []byte) (*Response, error) {
+	for attempt := 0; ; attempt++ {
+		resp, err := s.asp.Send(ctx, sender, payload)
+		if err != nil || resp.StatusCode != http.StatusTooManyRequests || attempt >= maxRateLimitRetries {
+			return resp, err
+		}
+		wait := time.Second
+		if n, convErr := strconv.Atoi(resp.RetryAfter); convErr == nil && n > 0 {
+			wait = time.Duration(n) * time.Second
+		}
+		s.log.Warn("asp rate limited, will resend", "invoice_id", id, "invoice_number", number,
+			"retry_after_s", wait.Seconds(), "attempt", attempt+1)
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(wait):
+		}
+	}
+}
