+// maxSources bounds memory: each entry holds the raw file, the parsed workbook and
+// every mapped invoice. Unbounded, this grew until the 128 MB container was OOM-killed.
+const maxSources = 10
+
 func (c *SourceCache) Put(importID string, s *Source) {
 	s.StoredAt = time.Now()
 	c.mu.Lock()
 	c.entries[importID] = s
+	for len(c.entries) > maxSources {
+		var oldestID string
+		var oldest time.Time
+		for id, e := range c.entries {
+			if oldestID == "" || e.StoredAt.Before(oldest) {
+				oldestID, oldest = id, e.StoredAt
+			}
+		}
+		delete(c.entries, oldestID)
+	}
 	c.mu.Unlock()
 }
 
